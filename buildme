  --enable-shared --enable-sharedlibs=gcc \
  --enable-debuginfo \
  --disable-new-dtags \
  ${PMI} \
  ${DEVICE_FLAGS} \
  ${REG_CACHE} \
  --with-ch3-rank-bits=32 \
  --enable-romio --with-file-system=lustre+nfs+ufs \
  --disable-mpe --without-mpe 2>&1 > configure.out

